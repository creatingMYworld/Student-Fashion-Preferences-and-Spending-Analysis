      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:What is your current level of study?:nk]' type='palette'>
            <map to='#4e79a7'>
              <bucket>&quot;B.Tech / B.E&quot;</bucket>
            </map>
            <map to='#59a14f'>
              <bucket>&quot;MBBS / Medical&quot;</bucket>
            </map>
            <map to='#76b7b2'>
              <bucket>&quot;MBA&quot;</bucket>
            </map>
            <map to='#e15759'>
              <bucket>&quot;M.Tech / M.E&quot;</bucket>
            </map>
            <map to='#edc948'>
              <bucket>&quot;Post-Graduate&quot;</bucket>
            </map>
            <map to='#f28e2b'>
              <bucket>&quot;Diploma&quot;</bucket>
            </map>
          </encoding>
          <encoding attr='color' field='[none:Gender:nk]' type='palette'>
