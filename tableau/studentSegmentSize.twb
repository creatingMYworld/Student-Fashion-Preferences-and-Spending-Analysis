      <column caption='Spend Bracket' datatype='string' name='[Calculation_0195211600310272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [What is your average spending ? (per year)] &lt; 15000 THEN &quot;Low Spender&quot; ELSEIF [What is your average spending ? (per year)] &lt; 22000 THEN &quot;Mid Spender&quot; ELSE &quot;High Spender&quot; END' />
